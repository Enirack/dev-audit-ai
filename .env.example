# Copy this file to .env and fill in real values. .env is gitignored and must
# never be committed.

# "mock" (default, no external calls, safe to leave unset) or "anthropic".
AI_ENGINE_PROVIDER=mock

# Required only when AI_ENGINE_PROVIDER=anthropic. Get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Shared secret used to authenticate backend -> ai-engine requests.
# Generate one with: php -r "echo bin2hex(random_bytes(32));"
AI_ENGINE_INTERNAL_SECRET=
